# Bắt buộc: API key Gemini (dùng chung cho sinh kịch bản + TTS)
GEMINI_API_KEY=
# Model (đổi được khi Google đổi tên model)
GEMINI_CONTENT_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_VOICE_FEMALE=Kore
GEMINI_TTS_VOICE_MALE=Charon
# Forced alignment caption qua Gemini (1=bật timing chính xác từng từ, 0=tắt dùng chia tỷ lệ)
FORCED_ALIGNMENT=1

# apps/server: số VIDEO render song song trong 1 tiến trình (pha ảnh/TTS I/O chồng lấn render CPU)
RENDER_CONCURRENCY=2
# Số FRAME song song khi render 1 video (quyết định tốc độ 1 video). Mặc định ~75%
# số nhân CPU nếu bỏ trống. Đừng để RENDER_CONCURRENCY × giá trị này vượt nhiều lần số nhân.
RENDER_FRAME_CONCURRENCY=6

# ===== apps/server =====
SERVER_PORT=4600
# PORT (chuẩn Cloud Run/PaaS) — nếu đặt sẽ ưu tiên hơn SERVER_PORT. Docker dùng 8080.
# PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3310
# Cloud SQL trên Cloud Run: đặt biến này = /cloudsql/<INSTANCE_CONNECTION_NAME>
# để nối qua Unix socket thay vì DB_HOST/DB_PORT (bỏ trống khi chạy Docker/local).
# DB_SOCKET_PATH=
DB_USER=ams
DB_PASSWORD=ams_dev_password
DB_NAME=ams
SESSION_TTL_HOURS=8
# Seed admin (chỉ dùng khi chạy: pnpm --filter @ams/server seed)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ===== Mã hoá token tích hợp (BẮT BUỘC khi bật Google Drive) =====
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# ===== Google Drive OAuth (tuỳ chọn — export video lên Drive) =====
# Lấy ở Google Cloud Console → Drive API + OAuth client (Web). Để trống = tắt tính năng.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect + web base PHẢI trỏ về đúng origin đang chạy (đăng ký redirect trong Console):
#   dev:    http://localhost:4600/... + http://localhost:4610
#   docker: http://localhost:8080/... + http://localhost:8080
GOOGLE_OAUTH_REDIRECT=http://localhost:4600/v1/integrations/gdrive/callback
WEB_BASE_URL=http://localhost:4610
